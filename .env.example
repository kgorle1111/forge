# The Forge — example environment file
#
# Copy to `.env` and edit; source it (`set -a; source .env; set +a`) or use
# your shell tool of choice. Nothing here is required — every var has a
# sensible default. `.env` itself is gitignored and must NEVER be committed.
#
# One-command reset: `unset $(grep -oE '^[A-Z_]+' .env.example)`

# ── Engine selection ──────────────────────────────────────────────
# Force an engine ("ollama" | "anthropic" | "stub"). Empty = auto:
# reachable Ollama → Anthropic key → offline demo stub. Explicit engines
# hard-fail with a prescriptive message when unavailable; auto never crashes.
# FORGE_ENGINE=

# Instant offline demo mode; overrides everything else. Handy for CI and QA.
# FORGE_STUB=1

# ── Ollama (local, private, free) ─────────────────────────────────
# Point at a non-default Ollama host if you moved it off localhost.
# FORGE_OLLAMA=http://localhost:11434

# Force a specific installed Ollama model (skip auto-pick).
# `ollama list` to see what you have. Try `llama3.1:8b-instruct` first.
# FORGE_MODEL=

# Use a different (usually stricter) model just for grading.
# Example: reasoning model for grading, fast model for teaching.
# FORGE_GRADER=deepseek-r1:32b

# ── Anthropic API (cloud, opt-in, cents per topic) ────────────────
# Get a key at https://console.anthropic.com/settings/keys and export it here.
# The key is sent ONLY to the endpoint below; never logged, never stored in
# the DB, never in any HTTP response, never bundled by `forge bundle-debug`.
# ANTHROPIC_API_KEY=

# Override the Anthropic base URL (proxy, staging, or test seam).
# WARNING: whoever controls this URL receives your prompts AND your key
# header. Only set to an HTTPS host you trust.
# FORGE_ANTHROPIC_URL=https://api.anthropic.com

# Whitelist doctor to actually spend tokens on a real latency probe.
# Default: doctor skips the Anthropic probe to avoid surprise API cost.
# FORGE_DOCTOR_PROBE=1

# ── Storage & profiles ────────────────────────────────────────────
# Where the single SQLite file lives. Move this to back up your history.
# FORGE_DB=~/.forge/forge.db

# Where engine config lives (0600, may hold an opt-in API key).
# FORGE_CONFIG=~/.forge/config.json

# Name a learner profile — uses ~/.forge/<name>.db instead of the default.
# Use per-topic profiles or per-family-member profiles.
# FORGE_LEARNER=kiddo

# Where generated SVG concept-map artifacts land.
# FORGE_ARTIFACT_DIR=~/.forge/visuals

# ── Voice mode (whisper.cpp + local recorder, all optional) ───────
# Absolute path to a whisper binary (whisper-cli, whisper-cpp, whisper).
# Auto-detects if unset. Explicit overrides fail closed — no silent fallback.
# FORGE_WHISPER=/opt/homebrew/bin/whisper-cli

# Absolute path to a whisper .bin model. Auto-picks the newest in
# ~/.forge/whisper/*.bin if unset.
# FORGE_WHISPER_MODEL=~/.forge/whisper/ggml-base.en.bin

# ── Web server binding ────────────────────────────────────────────
# Only override for containers / LAN exposure. Default 127.0.0.1 keeps the
# dashboard localhost-only; the Host-header allowlist rejects non-localhost
# hostnames even when this is 0.0.0.0. See SECURITY.md.
# FORGE_BIND=127.0.0.1

# ── Legacy / advanced ─────────────────────────────────────────────
# Legacy stub-dictation seams (use --voice instead in new code).
# FORGE_WHISPER_CMD=
# FORGE_DICTATION_WAV=
# FORGE_DICTATION_TEXT=
